    name(t8_eventstudy1, replace)
graph export "$figdir8/t8_eventstudy1.png", name(t8_eventstudy1) replace width(1600)

* --- PSM / IPW ---
capture quietly logit t8_treated t8_ps_x1 t8_ps_x2 t8_ps_x3 t8_ps_x4
capture predict t8_pscore, pr
capture gen t8_ipw = cond(t8_treated==1, 1/t8_pscore, 1/(1-t8_pscore))
capture replace t8_ipw = min(t8_ipw, 10)
regress price t8_treated [pw=t8_ipw], vce(robust)
estimates store t8_ipw1
regress price t8_treated mpg weight [pw=t8_ipw], vce(robust)
estimates store t8_ipw2

