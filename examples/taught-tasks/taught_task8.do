/*
================================================================================
File: taught_task8.do
Purpose: generated Stata Workbench/native Stata 18 stress fixture (MOST EXTREME)
Goal: expose gaps against realtime shared session, low latency, no hangs,
      unchanged research do-files, and native-like graph/table/document output.
Design: generated self-contained script, target >= 11000 lines.
        Maximum stress: 130+ graphs, 150+ regressions, 70+ putdocx, 60+ p_tdocx,
        brace depth 5-6, 4 preserve/restore, dual data merge, event study,
        IV, matching, mediation, coefplot, graph combine, trace output.
================================================================================
*/

version 18
cls
clear all
set more off
set seed 20260511
set maxvar 32000

local __taught_root "`c(pwd)'"
global workfolder "`__taught_root'"
global tempdir "${workfolder}/7_temp"
global docdir "${workfolder}/4_tables"
local t8_run_stamp = subinstr("`=c(current_date)'_`=c(current_time)'", " ", "_", .)
local t8_run_stamp = subinstr("`t8_run_stamp'", ":", "", .)
global figdir8 "${tempdir}/taught_task8_graphs/`t8_run_stamp'"
cap mkdir "${tempdir}/taught_task8_graphs"
cap mkdir "$figdir8"
cap mkdir "$docdir"

capture which p_tdocx
if _rc {
    capture program drop p_tdocx
    program define p_tdocx
        putdocx `0'
    end
}

display as text "===== TAUGHT TASK 8 SELF-CHECK START ====="
display as text "Stata version: " c(stata_version)
display as text "Date: " c(current_date) " Time: " c(current_time)

// #region Section 1: setup with dual data merge
display as text ">>> START Section 1: setup with dual data merge"
sysuse auto, clear
expand 12
sort make
gen obs_id = _n
gen price_ln = ln(price)
gen mpg_sq = mpg^2
gen weight_ton = weight / 1000
gen length_sq = length^2
gen turn_sq = turn^2
gen displacement_ln = ln(displacement)
gen base_score = price_ln + mpg/10 - weight_ton + gear_ratio
gen t8_work = base_score
gen t8_rank_source = price + mpg * 100 - weight
egen t8_price_q = cut(price), group(5)
egen t8_mpg_t = cut(mpg), group(4)
gen t8_group = mod(obs_id, 16) + 1
gen t8_flag = price > 7000 | mpg > 22

* Panel structure
gen t8_year = 2008 + mod(obs_id, 12)
gen t8_treated = (foreign == 1)
gen t8_post = (t8_year >= 2014)
gen t8_did = t8_treated * t8_post
gen t8_event_time = t8_year - 2014

* IV instruments (multiple)
gen t8_inst1 = length + rnormal(0, 4)
gen t8_inst2 = turn + rnormal(0, 2.5)
gen t8_inst3 = displacement/10 + rnormal(0, 1)
gen t8_endog1 = weight + 0.4*t8_inst1 + 0.3*t8_inst2 + 0.2*t8_inst3 + rnormal(0, 40)
gen t8_endog2 = mpg + 0.2*t8_inst1 - 0.1*t8_inst2 + 0.4*t8_inst3 + rnormal(0, 3)

* Mediator and outcome
gen t8_med1 = 0.5*price_ln + 0.2*mpg + rnormal(0, 1.8)
gen t8_med2 = 0.3*weight_ton + 0.4*gear_ratio + rnormal(0, 1.2)
gen t8_med3 = 0.1*length + 0.6*turn/10 + rnormal(0, 2)
gen t8_outcome = 0.3*t8_med1 + 0.4*t8_med2 + 0.2*t8_med3 + rnormal(0, 3)

* PSM variables
gen t8_ps_x1 = price/1000 + rnormal(0, 0.4)
gen t8_ps_x2 = mpg/10 + rnormal(0, 0.25)
gen t8_ps_x3 = weight/1000 + rnormal(0, 0.15)
gen t8_ps_x4 = length/100 + rnormal(0, 0.1)

* Create secondary dataset for merge
preserve
    collapse (mean) price mpg weight, by(t8_group)
    rename price t8_grp_mean_price
    rename mpg t8_grp_mean_mpg
    rename weight t8_grp_mean_weight
    tempfile t8_groupmeans
    save `t8_groupmeans'
restore
merge m:1 t8_group using `t8_groupmeans', nogen

compress
describe
summarize price mpg weight length turn displacement gear_ratio
display as result "<<< DONE Section 1: setup with dual data merge"
// #endregion Section 1: setup with dual data merge

