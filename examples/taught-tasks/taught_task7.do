version 18
cls
clear all
set more off
set seed 20260510
set maxvar 20000

local __taught_root "`c(pwd)'"
global workfolder "`__taught_root'"
global tempdir "${workfolder}/7_temp"
global docdir "${workfolder}/4_tables"
local t7_run_stamp = subinstr("`=c(current_date)'_`=c(current_time)'", " ", "_", .)
local t7_run_stamp = subinstr("`t7_run_stamp'", ":", "", .)
global figdir7 "${tempdir}/taught_task7_graphs/`t7_run_stamp'"
cap mkdir "${tempdir}/taught_task7_graphs"
cap mkdir "$figdir7"
cap mkdir "$docdir"

capture which p_tdocx
if _rc {
    capture program drop p_tdocx
    program define p_tdocx
        putdocx `0'
    end
}

display as text "===== TAUGHT TASK 7 SELF-CHECK START ====="
display as text "Stata version: " c(stata_version)
display as text "Date: " c(current_date) " Time: " c(current_time)

// #region Section 1: setup and base data
display as text ">>> START Section 1: setup and base data"
sysuse auto, clear
expand 10
sort make
gen obs_id = _n
gen price_ln = ln(price)
gen mpg_sq = mpg^2
gen weight_ton = weight / 1000
gen length_sq = length^2
gen turn_sq = turn^2
gen displacement_ln = ln(displacement)
gen base_score = price_ln + mpg/10 - weight_ton + gear_ratio
gen t7_work = base_score
gen t7_rank_source = price + mpg * 100 - weight
egen t7_price_q = cut(price), group(4)
egen t7_mpg_t = cut(mpg), group(3)
gen t7_group = mod(obs_id, 14) + 1
gen t7_flag = price > 8000 | mpg > 25

* Panel structure for DiD/event study
gen t7_year = 2010 + mod(obs_id, 10)
gen t7_treated = (foreign == 1)
gen t7_post = (t7_year >= 2015)
gen t7_did = t7_treated * t7_post
gen t7_event_time = t7_year - 2015

* IV instruments
gen t7_instrument1 = length + rnormal(0, 5)
gen t7_instrument2 = turn + rnormal(0, 3)
gen t7_endog = weight + 0.5 * t7_instrument1 + 0.3 * t7_instrument2 + rnormal(0, 50)

* Mediator variables
gen t7_mediator1 = 0.4 * price_ln + 0.3 * mpg + rnormal(0, 2)
gen t7_mediator2 = 0.2 * weight_ton + 0.5 * gear_ratio + rnormal(0, 1.5)

* Propensity score variables
gen t7_pscore_x1 = price/1000 + rnormal(0, 0.5)
gen t7_pscore_x2 = mpg/10 + rnormal(0, 0.3)
gen t7_pscore_x3 = weight/1000 + rnormal(0, 0.2)

compress
describe
summarize price mpg weight length turn displacement gear_ratio
display as result "<<< DONE Section 1: setup and base data"
// #endregion Section 1: setup and base data

