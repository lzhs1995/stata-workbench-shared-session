ivregress 2sls price mpg weight (t7_endog = t7_instrument1 t7_instrument2 length)
estimates store t7_iv2

* --- DiD simulation ---
regress price t7_treated t7_post t7_did i.t7_year, vce(cluster t7_group)
estimates store t7_did1
regress price t7_treated t7_post t7_did mpg weight i.t7_year, vce(cluster t7_group)
estimates store t7_did2

* --- Event study ---
char t7_event_time[omit] -1
xi i.t7_event_time, prefix(_ET)
quietly regress price _ET* t7_treated i.t7_year, vce(cluster t7_group)
estimates store t7_event1

* Event study coefplot
coefplot t7_event1, keep(_ET*) vertical ///
    yline(0, lcolor(red)) title("Event Study: Price") ///
    name(t7_eventstudy, replace)
graph export "$figdir7/t7_eventstudy.png", name(t7_eventstudy) replace width(1600)

* --- Matching / PSM simulation ---
quietly logit t7_treated t7_pscore_x1 t7_pscore_x2 t7_pscore_x3
predict t7_pscore, pr
gen t7_ipw = cond(t7_treated==1, 1/t7_pscore, 1/(1-t7_pscore))
regress price t7_treated [pw=t7_ipw], vce(robust)
estimates store t7_ipw1

* --- Mediation style ---
quietly regress t7_mediator1 t7_treated mpg weight, vce(robust)
estimates store t7_med_m1
quietly regress price t7_treated t7_mediator1 mpg weight, vce(robust)
estimates store t7_med_y1
quietly regress t7_mediator2 t7_treated mpg weight, vce(robust)
estimates store t7_med_m2
quietly regress price t7_treated t7_mediator2 mpg weight, vce(robust)
estimates store t7_med_y2

* --- Interaction margins ---
quietly regress price c.mpg##c.weight##i.foreign, vce(robust)
margins foreign, at(mpg=(15(5)40) weight=(2000(500)4500))
marginsplot, name(t7_margins1, replace)
graph export "$figdir7/t7_margins1.png", name(t7_margins1) replace width(1600)

quietly regress price c.mpg##i.t7_price_q##i.foreign, vce(robust)
margins t7_price_q#foreign, at(mpg=(15(5)40))
marginsplot, name(t7_margins2, replace)
graph export "$figdir7/t7_margins2.png", name(t7_margins2) replace width(1600)

* --- Coefplot comparisons ---
coefplot t7_ols01 t7_ols02 t7_ols03, drop(_cons) ///
    title("OLS Comparison 1-3") name(t7_coef1, replace)
graph export "$figdir7/t7_coef1.png", name(t7_coef1) replace width(1600)
